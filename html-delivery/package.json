{
  "name": "html-delivery",
  "version": "1.0.0",
  "private": true,
  "description": "수강생 HTML 게임 업로드·배포 운영 프로그램",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p frontend/tsconfig.json",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:web-budget": "node scripts/check-web-budget.js",
    "backfill:cohort-ids": "node scripts/backfill-cohort-ids.js",
    "backfill:content-versions": "node scripts/backfill-content-versions.js",
    "migrate:content-objects": "node scripts/copy-legacy-content-objects.js",
    "migrate:content-read-pointers": "node scripts/switch-content-read-pointers.js",
    "audit:legacy-cleanup": "node scripts/audit-legacy-cleanup.js",
    "collect:legacy-usage": "node scripts/collect-legacy-usage.js",
    "migrate:retire-legacy-fallbacks": "node scripts/retire-legacy-fallbacks.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1085.0",
    "@aws-sdk/client-lambda": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/lib-dynamodb": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "archiver": "^8.0.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "adm-zip": "^0.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
